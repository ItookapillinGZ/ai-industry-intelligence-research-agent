# Copy this file to .env. Never commit real credentials.
AI_INTEL_LLM_PROVIDER=disabled
AI_INTEL_LLM_API_KEY=
AI_INTEL_LLM_MODEL=gpt-4.1-mini
AI_INTEL_LLM_BASE_URL=https://api.openai.com/v1
AI_INTEL_LLM_TIMEOUT_SECONDS=30

# Optional runtime overrides
AI_INTEL_CONFIG_PATH=config/sources.yaml
AI_INTEL_LOG_LEVEL=INFO

